{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mango Finder",
  "identifier": "myz.mango-finder",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build && cd src-tauri && cargo build --release --bin mfd",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mango Finder",
        "width": 1000,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Copyright Mango Finder",
    "shortDescription": "Search your data using natural language",
    "longDescription": "Search your data using natural language",
    "publisher": "Mango Finder"
  }
}
