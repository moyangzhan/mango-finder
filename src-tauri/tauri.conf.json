{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mango Finder",
  "version": "0.12.0",
  "identifier": "myz.mango-finder",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mango Finder",
        "width": 1000,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": [
      "assets/model/embedding.onnx",
      "assets/model/embedding_tokenizer.json",
      "assets/model/vision.onnx",
      "assets/model/vision_tokenizer.json",
      "assets/model/whisper-small-q8_0.bin",
      "assets/model/ch_PP-OCRv4_det_infer.onnx",
      "assets/model/ch_ppocr_mobile_v2.0_cls_infer.onnx",
      "assets/model/ch_PP-OCRv4_rec_infer.onnx",
      "assets/model/ppocr_keys_v1.txt"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Copyright Mango Finder",
    "shortDescription": "Search your data using natural language",
    "longDescription": "Search your data using natural language",
    "publisher": "Mango Finder"
  }
}
